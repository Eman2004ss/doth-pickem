# Copy your Neon connection string from the Neon dashboard -> Connect.
# Do not commit the real value. Render should receive this as an environment variable.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional. The first empty database is seeded from database/database.xlsx by default.
SEED_FROM_XLSX=true

# Use a long random value in production for NiceGUI browser storage signing.
STORAGE_SECRET=replace-with-a-long-random-secret
